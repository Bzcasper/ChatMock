# ===== Server Configuration =====
PORT=8000
HOST=0.0.0.0

# ===== Storage Configuration =====
# Auth storage directory (local: ~/.chatgpt-local, Docker: /app/data)
CHATGPT_LOCAL_HOME=/app/data

# ===== Token Refresh Configuration =====
# Timeout for token refresh requests in seconds (default: 30)
CHATGPT_TOKEN_REFRESH_TIMEOUT=30

# Maximum retry attempts for token refresh (default: 3)
CHATGPT_TOKEN_REFRESH_MAX_RETRIES=3

# ===== Logging & Debugging =====
# Show request/response logs for debugging
VERBOSE=false

# Obfuscate sensitive data in verbose logs
VERBOSE_OBFUSCATION=false

# ===== Authentication =====
# OAuth client id (modify only if you know what you're doing)
# CHATGPT_LOCAL_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# ===== Reasoning Controls =====
CHATGPT_LOCAL_REASONING_EFFORT=medium       # minimal|low|medium|high|xhigh
CHATGPT_LOCAL_REASONING_SUMMARY=auto        # auto|concise|detailed|none
CHATGPT_LOCAL_REASONING_COMPAT=think-tags   # legacy|o3|think-tags|current
CHATGPT_LOCAL_EXPOSE_REASONING_MODELS=false

# Enable default web search tool
CHATGPT_LOCAL_ENABLE_WEB_SEARCH=false

# ===== Model Selection =====
# Force a specific model name (debugging only)
# CHATGPT_LOCAL_DEBUG_MODEL=gpt-5

# ===== Python Configuration =====
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
