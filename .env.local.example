# ============================================================================
# LOCAL SECRETS TEMPLATE - FOR DEVELOPMENT ONLY
# ============================================================================
#
# IMPORTANT: This file shows the structure for .env.local
#
# DO NOT COMMIT THIS FILE
# DO NOT STORE ACTUAL SECRETS IN GIT
#
# Instructions:
# 1. Copy this file to .env.local (git will ignore it)
# 2. Fill in YOUR ACTUAL secrets (tokens, keys, etc.)
# 3. NEVER commit .env.local - it stays local only
# 4. For deployment, use SSH console or secure secrets management
#
# ============================================================================

# ===== OpenAI Authentication =====
# Your actual OpenAI API tokens (NEVER commit these)
# Get these from: https://auth.openai.com/authorize (for local auth)

# OpenAI ID Token (JWT format)
# This is used for authentication with OpenAI's API
OPENAI_ID_TOKEN=YOUR_ACTUAL_ID_TOKEN_HERE

# OpenAI Access Token (JWT format)
# This is the main token for API requests
OPENAI_ACCESS_TOKEN=YOUR_ACTUAL_ACCESS_TOKEN_HERE

# OpenAI Refresh Token (used to get new access tokens)
# This allows automatic token refresh when expired
OPENAI_REFRESH_TOKEN=YOUR_ACTUAL_REFRESH_TOKEN_HERE

# Your ChatGPT Account ID
OPENAI_ACCOUNT_ID=YOUR_ACTUAL_ACCOUNT_ID_HERE

# ===== Deployment Secrets (for Fly.io or other platforms) =====
# These should be set via environment variables in the deployment platform
# NOT stored in .env files for production

# Example (keep commented unless using locally):
# FLY_AUTH_TOKEN=YOUR_FLY_AUTH_TOKEN_HERE
# DATABASE_URL=postgresql://user:password@host/database

# ===== Development Settings =====
# Set to true for detailed logging when debugging
VERBOSE=false

# Set to true to hide sensitive data in logs
VERBOSE_OBFUSCATION=true

# ===== Token Refresh Settings =====
CHATGPT_TOKEN_REFRESH_TIMEOUT=30
CHATGPT_TOKEN_REFRESH_MAX_RETRIES=3

# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# .env.local is in .gitignore and will NEVER be committed
#
# For production/deployment:
# - Use the platform's secrets management (Fly.io secrets, GitHub secrets, etc.)
# - NEVER hardcode secrets in .env files
# - Use SSH console to inject secrets into persistent volumes
# - Example Fly.io command:
#   $ flyctl ssh console -a chatmock-prod
#   $ mkdir -p /app/data
#   $ cat > /app/data/auth.json << 'EOF'
#   { "tokens": { "id_token": "...", ... } }
#   EOF
#
# ============================================================================
